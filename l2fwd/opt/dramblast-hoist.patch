-      idx = dramblast_hash(ht, arg->k);
-      dramblast_prefetch(ht, idx);
-      dramblast_push_queue(ht, idx, arg->k, 0, arg->id, id);
+      idx = (uint64_t)_mm_crc32_u64(0, arg->k) & tbl_mask &
