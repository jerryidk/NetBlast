+  dramblast_queue_item_t *const fq = q->find_queue;
+  dramblast_kv_t *const table = ht->table;
+  const uint64_t tbl_mask = ht->len - 1;
+  const uint64_t tbl_len = ht->len;
+  const uint32_t q_mask = q->find_queue_size - 1;
+  uint32_t head = q->find_queue_head;
+  uint32_t tail = q->find_queue_tail;
